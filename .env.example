# ==============================================================================
# Movie Magic — Application Environment Configuration Template
# NOTE: Copy this file to '.env' for local development. Never commit '.env'.
# ==============================================================================

# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev-insecure-secret-key-change-in-production-movie-magic-2026

# Application Settings
APP_NAME=Movie Magic
APP_PORT=5000
APP_HOST=127.0.0.1

# Session Security
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# AWS Integration Settings (Phase 1: Stub / Local Demo Mode)
# Leave AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY blank for local demo mode.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DYNAMODB_TABLE_PREFIX=moviemagic_
SNS_BOOKING_TOPIC_ARN=
USE_AWS_MOCK=True
